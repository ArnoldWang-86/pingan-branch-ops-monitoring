# ============================================================
#  环境变量模板 —— 复制为 .env 后填写自己的值
#  真实的 .env 已被 .gitignore 排除，不会进仓库
# ============================================================

# DeepSeek API Key（仅在网页 Agent 里填 Key 时才需要）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# SQL 执行引擎配置（本地用 DuckDB，无需填）
OPS_SQL_ENGINE=duckdb
OPS_DB_PATH=tools/pingan_ops.duckdb
